---
import GoalieLayout from '../../layouts/GoalieLayout.astro';

const title = 'Thanks for downloading Goalie';
const description = 'Your Goalie download link is on its way. Check your email for the macOS installer.';
---

<GoalieLayout {title} {description}>
  <main class="goalie-page thank-you-page">
    <article class="thank-you-card" aria-labelledby="thank-you-title">
      <div class="thank-you-grid" aria-hidden="true"></div>
      <div class="thank-you-mascot">
        <div class="speech-bubble speech-bubble--thank">See you on the factory floor!</div>
        <img class="thank-you-icon" src="/goalie/icon.png" alt="Goalie mascot" width="112" height="112" />
      </div>
      <h1 id="thank-you-title">Thanks for downloading Goalie!</h1>
      <p class="thank-you-lede">
        Your .dmg is sprinting to your inbox right now. Go check your email for the download link.
      </p>
      <p class="thank-you-tip">
        <span aria-hidden="true">📬</span>
        Don&apos;t see it? Check spam or promotions.
      </p>
      <div class="thank-you-actions">
        <a class="btn-primary" href="/goalie">Back to Goalie</a>
      </div>
      <p class="thank-you-foot">
        Need help? <a href="https://x.com/rachelnocode" target="_blank" rel="noopener noreferrer">DM @rachelnocode</a>
      </p>
    </article>
  </main>
</GoalieLayout>

<style>
  .thank-you-page {
    min-height: calc(100svh - 80px);
    display: grid;
    place-items: center;
    padding-top: 48px;
    padding-bottom: 72px;
  }

  .thank-you-card {
    position: relative;
    width: min(520px, 100%);
    padding: 40px 32px 32px;
    border: 2px solid var(--border);
    border-radius: 32px;
    background: var(--cream);
    box-shadow: var(--shadow), 8px 8px 0 rgba(17, 17, 17, 0.1);
    text-align: center;
  }

  .thank-you-grid {
    position: absolute;
    inset: 0 0 auto;
    height: 160px;
    border-radius: 30px 30px 0 0;
    background-image: radial-gradient(rgba(200, 230, 160, 0.55) 1px, transparent 1px);
    background-size: 16px 16px;
    -webkit-mask-image: linear-gradient(#000, transparent);
    mask-image: linear-gradient(#000, transparent);
    pointer-events: none;
  }

  .thank-you-mascot {
    position: relative;
    display: grid;
    place-items: center;
    width: fit-content;
    margin: 0 auto 22px;
  }

  .thank-you-icon {
    position: relative;
    display: block;
    width: 112px;
    height: 112px;
    border: 2px solid var(--border);
    border-radius: 24px;
    box-shadow: 4px 4px 0 rgba(17, 17, 17, 0.12);
  }

  .speech-bubble--thank {
    position: relative;
    top: auto;
    right: auto;
    left: auto;
    margin: 0 0 14px;
    max-width: 240px;
    animation: none;
  }

  .speech-bubble--thank::after {
    left: 50%;
    right: auto;
    bottom: -12px;
    transform: translateX(-50%) rotate(45deg);
  }

  .thank-you-card h1 {
    position: relative;
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .thank-you-lede {
    position: relative;
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
  }

  .thank-you-tip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
    padding: 12px 16px;
    border: 2px solid rgba(17, 17, 17, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  .thank-you-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .thank-you-foot {
    position: relative;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .thank-you-foot a {
    color: var(--ink);
    font-weight: 600;
  }
</style>
