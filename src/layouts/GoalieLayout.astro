---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

import { GOALIE_POLAR_CHECKOUT_URL } from '../goalie/polar';

const { title, description, ogImage = '/goalie/screenshot-home.png' } = Astro.props;
const site = 'https://www.rachelnocode.com';
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const absoluteOgImage = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#d4ebe0" />
    <link rel="icon" type="image/png" href="/goalie/icon.png" />
    <link rel="apple-touch-icon" href="/goalie/icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="site-nav" aria-label="Goalie navigation">
      <a class="brand" href="/">
        <img src="/goalie/icon.png" alt="" width="32" height="32" class="brand-icon" />
        <span>Rachel noCode</span>
      </a>
      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#screenshots">See it</a>
        <a class="nav-cta" href={GOALIE_POLAR_CHECKOUT_URL} data-goalie-download>Download Goalie now</a>
      </div>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --mint: #d4ebe0;
    --mint-deep: #b8dccf;
    --cream: #f7f3ea;
    --cream-dark: #efe8da;
    --yellow: #f5e6a8;
    --yellow-bright: #ffe566;
    --pink: #f5d5d5;
    --green: #c8e6a0;
    --ink: #111111;
    --muted: #5a5a52;
    --border: #111111;
    --shadow: 0 18px 50px rgba(17, 17, 17, 0.12);
    --font-display: "Bricolage Grotesque", system-ui, sans-serif;
    --font-body: Inter, -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --radius-lg: 28px;
    --radius-md: 18px;
    --radius-pill: 999px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--mint);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 12% 18%, rgba(255, 229, 102, 0.35), transparent 28%),
      radial-gradient(circle at 88% 12%, rgba(200, 230, 160, 0.45), transparent 24%),
      radial-gradient(circle at 70% 88%, rgba(245, 213, 213, 0.35), transparent 30%);
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  .site-nav {
    position: relative;
    z-index: 10;
    max-width: 1120px;
    margin: 0 auto;
    padding: 22px 24px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
  }

  .brand-icon {
    border-radius: 9px;
    box-shadow: 0 4px 12px rgba(17, 17, 17, 0.14);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 600;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-cta {
    padding: 9px 16px;
    border: 2px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--cream) !important;
  }

  .nav-cta:hover {
    transform: translateY(-1px);
  }

  .goalie-page {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px 72px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding: 7px 14px;
    border: 2px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--yellow);
    font: 12px/1.2 var(--font-body);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    padding: 36px 0 56px;
  }

  .hero-copy h1 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 88px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero-copy .tagline {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .hero-copy .lede {
    margin: 0 0 28px;
    max-width: 540px;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 20px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary {
    border: 2px solid var(--border);
    background: var(--ink);
    color: var(--cream);
    box-shadow: 0 8px 0 rgba(17, 17, 17, 0.18);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 0 rgba(17, 17, 17, 0.18);
  }

  .btn-secondary {
    border: 2px solid var(--border);
    background: var(--cream);
    color: var(--ink);
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 2px solid rgba(17, 17, 17, 0.12);
    border-radius: var(--radius-pill);
    background: rgba(247, 243, 234, 0.72);
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .pill strong {
    color: var(--ink);
  }

  .hero-mascot {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-mascot-card {
    position: relative;
    width: min(100%, 320px);
    padding: 28px;
    border: 2px solid var(--border);
    border-radius: 32px;
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .hero-mascot-card img {
    width: 160px;
    height: 160px;
    margin: 0 auto 16px;
    border-radius: 28px;
  }

  .hero-mascot-card p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
  }

  .hero-mascot-card span {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }

  .speech-bubble {
    position: absolute;
    top: -8px;
    right: -10px;
    max-width: 180px;
    padding: 12px 14px;
    border: 2px solid var(--border);
    border-radius: 18px;
    background: var(--green);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    box-shadow: 4px 4px 0 rgba(17, 17, 17, 0.12);
    animation: bob 4s ease-in-out infinite;
  }

  .speech-bubble::after {
    content: "";
    position: absolute;
    left: 22px;
    bottom: -12px;
    width: 18px;
    height: 18px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: var(--green);
    transform: rotate(45deg);
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }

  .step-card {
    padding: 22px 20px;
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.08);
  }

  .step-card:nth-child(2) {
    background: var(--yellow);
  }

  .step-card:nth-child(3) {
    background: var(--pink);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
    border: 2px solid var(--border);
    border-radius: 50%;
    background: white;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
  }

  .step-card h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .step-card p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .section-head {
    margin-bottom: 28px;
    text-align: center;
  }

  .section-head h2 {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .section-head p {
    margin: 0 auto;
    max-width: 620px;
    color: var(--muted);
    font-size: 18px;
  }

  .shot-section {
    margin-bottom: 72px;
  }

  .shot-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3.5vw, 40px);
    align-items: start;
    justify-items: center;
    max-width: 1120px;
    margin: 0 auto;
  }

  .shot-panel {
    width: 100%;
    max-width: 520px;
  }

  .shot-visual {
    position: relative;
    padding-bottom: 42px;
  }

  .shot-panel picture {
    display: block;
    width: 100%;
  }

  .shot-panel img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(17, 17, 17, 0.14);
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(17, 17, 17, 0.08);
  }

  .callout {
    position: absolute;
    z-index: 2;
    max-width: min(250px, 72%);
    padding: 12px 14px;
    border: 2px solid var(--border);
    border-radius: 18px;
    box-shadow: 4px 4px 0 rgba(17, 17, 17, 0.1);
  }

  .callout::after {
    content: "";
    position: absolute;
    top: -11px;
    width: 16px;
    height: 16px;
    border-left: 2px solid var(--border);
    border-top: 2px solid var(--border);
    transform: rotate(45deg);
  }

  .callout strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .callout p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
  }

  .callout--home {
    left: 10px;
    bottom: 14px;
    background: var(--yellow);
  }

  .callout--home::after {
    left: 26px;
    background: var(--yellow);
  }

  .callout--goals {
    right: 10px;
    bottom: 14px;
    background: var(--pink);
  }

  .callout--goals::after {
    right: 26px;
    background: var(--pink);
  }

  .local-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 22px;
    margin-bottom: 64px;
  }

  .local-card,
  .mascot-card {
    padding: 28px;
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.08);
  }

  .local-card h2,
  .mascot-card h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .local-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-list li {
    display: flex;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.1);
  }

  .local-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .local-list li::before {
    content: "✓";
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 2px solid var(--border);
    border-radius: 50%;
    background: var(--green);
    font-size: 14px;
    font-weight: 800;
  }

  .mascot-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(180deg, #fff 0%, var(--cream) 100%);
  }

  .mascot-card img {
    width: 120px;
    height: 120px;
    margin-bottom: 18px;
    border-radius: 24px;
  }

  .mascot-card p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
  }

  .get-card {
    padding: 36px 28px;
    border: 2px solid var(--border);
    border-radius: calc(var(--radius-lg) + 4px);
    background: var(--ink);
    color: var(--cream);
    text-align: center;
    box-shadow: var(--shadow);
  }

  .get-card h2 {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .get-card p {
    margin: 0 auto 24px;
    max-width: 560px;
    color: rgba(247, 243, 234, 0.78);
    font-size: 18px;
  }

  .get-card .btn-primary {
    background: var(--yellow-bright);
    color: var(--ink);
  }

  .page-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 2px solid rgba(17, 17, 17, 0.12);
    text-align: center;
    color: var(--muted);
    font-size: 14px;
  }

  .page-footer a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 960px) {
    .hero,
    .local-grid {
      grid-template-columns: 1fr;
    }

    .hero-mascot {
      order: -1;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .shot-row {
      grid-template-columns: 1fr;
      max-width: 520px;
    }

    .shot-visual {
      padding-bottom: 0;
    }

    .callout {
      position: relative;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      max-width: none;
      margin-top: -8px;
    }

    .callout::after {
      top: -11px;
      left: 26px !important;
      right: auto !important;
    }
  }

  @media (max-width: 640px) {
    .site-nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      flex-wrap: wrap;
    }

    .goalie-page {
      padding-inline: 18px;
    }

    .hero-actions .btn-primary,
    .hero-actions .btn-secondary {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speech-bubble {
      animation: none;
    }
  }
</style>
