{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.maxxtoken.app" }],
      "destination": "https://maxxtoken.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/maxxtoken/:path*",
      "has": [{ "type": "host", "value": "maxxtoken.app" }],
      "destination": "/maxxtoken/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "maxxtoken.app" }],
      "destination": "/maxxtoken"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "maxxtoken.app" }],
      "destination": "/maxxtoken/:path*"
    }
  ]
}
